# HubSpot Private App Token
# Create one at: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Google Sheets
# Either provide a Sheet ID + service account JSON path
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# Sync settings
SYNC_MODE=upsert          # upsert | create_only | update_only
DEDUP_FIELD=email         # Field used to detect duplicates
DRY_RUN=false             # Set to true to preview without writing
